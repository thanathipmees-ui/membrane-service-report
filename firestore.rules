rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /companies/{companyId} {
      allow read, write: if true;
    }
    match /ro_systems/{roId} {
      allow read, write: if true;
    }
    match /membranes/{membraneId} {
      allow read, write: if true;
    }
  }
}
